# Postgres. Em produção (Vercel), use a connection string do Vercel Postgres
# (aba Storage do projeto) — ela é injetada automaticamente como DATABASE_URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/grao_alto"

# Segredo usado para assinar o JWT de sessão (cookie httpOnly). Gere um valor
# aleatório forte em produção, ex: `openssl rand -hex 32`.
AUTH_SECRET="troque-por-um-segredo-aleatorio-de-verdade"

# Base URL usada para montar links em e-mails simulados (confirmação de
# cadastro, redefinição de senha, confirmação de pedido). Em produção, use a
# URL pública do deploy (ex: https://seu-app.vercel.app).
APP_URL="http://localhost:3000"
